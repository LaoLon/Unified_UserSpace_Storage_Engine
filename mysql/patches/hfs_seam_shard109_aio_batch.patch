+/* Runs a whole adjacent HFS AIO batch through this thread's client: every
+ * request is submitted before the first completion is reaped, so one io thread
+ * keeps several device I/Os in flight and pays one poll loop per batch instead
+ * of one wait per slot. Falls back to the per-slot path when the batch cannot
+ * be submitted or any request fails. */
+bool aioBatch(const AioBatchRequest *requests, std::size_t count) {
+  if (requests == nullptr || count == 0) {
+    return false;
+  }
+  ThreadClientHolder *holder = t_holder.get();
+  if (holder == nullptr || holder->client == nullptr) {
+    (void)threadClient();
+    holder = t_holder.get();
+  }
+  if (holder == nullptr || holder->client == nullptr) {
+    return false;
+  }
+  /* Keep each in-flight chunk below the client's outstanding credit. */
+  constexpr std::size_t kBatchChunk = 16;
+  const auto deadline =
+      std::chrono::steady_clock::now() + std::chrono::seconds(60);
+  std::size_t done = 0;
+  while (done < count) {
+    const std::size_t chunk = std::min(kBatchChunk, count - done);
+    std::array<std::uint64_t, kBatchChunk> ids{};
+    std::size_t submitted = 0;
+    bool abort = false;
+    for (std::size_t i = 0; i < chunk && !abort; ++i) {
+      const AioBatchRequest &request = requests[done + i];
+      auto file = lookupHandle(request.handle);
+      if (file == nullptr || request.ptr == nullptr || request.len == 0) {
+        abort = true;
+        break;
+      }
+      hfs::CompletionToken token{};
+      token.slot = static_cast<std::uint32_t>(i);
+      token.generation = ++holder->tokenGeneration;
+      if (token.generation == 0) {
+        token.generation = ++holder->tokenGeneration;
+      }
+      hfs::IoVec vec{static_cast<std::byte *>(request.ptr), request.len};
+      auto submittedResult =
+          request.write
+              ? holder->client->submitWrite(file, vec, request.offset, token)
+              : holder->client->submitRead(file, vec, request.offset, token);
+      if (!submittedResult.ok()) {
+        abort = true;
+        break;
+      }
+      ids[i] = submittedResult.value().requestId();
+      ++submitted;
+    }
+    /* Reap everything already submitted before reporting the fallback. */
+    std::size_t remaining = submitted;
+    bool ok = !abort;
+    std::array<hfs::CompletionEvent, 32> events{};
+    while (remaining > 0) {
+      auto polled = holder->client->poll(
+          std::span<hfs::CompletionEvent>(events.data(), events.size()), 1,
+          events.size(), std::chrono::microseconds(1000));
+      if (polled.status != hfs::Status::Ok) {
+        return false;
+      }
+      for (std::size_t e = 0; e < polled.count; ++e) {
+        for (std::size_t j = 0; j < submitted; ++j) {
+          if (ids[j] != 0 && ids[j] == events[e].requestId) {
+            ids[j] = 0;
+            --remaining;
+            if (events[e].status != hfs::Status::Ok) {
+              ok = false;
+            }
+          }
+        }
+      }
+      if (std::chrono::steady_clock::now() >= deadline) {
+        return false;
+      }
+    }
+    if (!ok) {
+      return false;
+    }
+    state().asyncBatchIos.fetch_add(submitted, std::memory_order_relaxed);
+    done += chunk;
+  }
+  return true;
+}
