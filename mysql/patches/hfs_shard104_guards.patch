diff --git a/sql/mysqld.cc b/sql/mysqld.cc
--- a/sql/mysqld.cc
+++ b/sql/mysqld.cc
@@ -7758,6 +7758,22 @@ int mysqld_main(int argc, char **argv)
 
 #if !defined(_WIN32)
 
+  /* HFS owns an in-process bdev and cannot survive a daemon fork. */
+  const char *hfsConfig = getenv("HFS_MYSQL_CONFIG");
+  if (hfsConfig != nullptr && *hfsConfig != '\0') {
+    if (opt_daemonize) {
+      fprintf(stderr, "hfs_vfs: --daemonize is unsupported\n");
+      unireg_abort(MYSQLD_ABORT_EXIT);
+    }
+    /* MyISAM is outside the HFS datadir contract. */
+    if (!opt_initialize && !opt_initialize_insecure &&
+        (opt_disabled_storage_engines == nullptr ||
+         strstr(opt_disabled_storage_engines, "MyISAM") == nullptr)) {
+      fprintf(stderr, "hfs_vfs: disable MyISAM with --disabled-storage-engines=MyISAM\n");
+      unireg_abort(MYSQLD_ABORT_EXIT);
+    }
+  }
+
   if (opt_initialize && opt_daemonize) {
     fprintf(stderr, "Initialize and daemon options are incompatible.\n");
     unireg_abort(MYSQLD_ABORT_EXIT);
diff --git a/storage/innobase/handler/ha_innodb.cc b/storage/innobase/handler/ha_innodb.cc
--- a/storage/innobase/handler/ha_innodb.cc
+++ b/storage/innobase/handler/ha_innodb.cc
@@ -5142,6 +5142,17 @@ static int innodb_init(void *p) {
 static int innodb_init(void *p) {
   DBUG_TRACE;
 
-  hfs_vfs::init();
+  /* Reject native AIO and mount failures before opening any datadir file. */
+  const char *hfsConfig = getenv("HFS_MYSQL_CONFIG");
+  if (hfsConfig != nullptr && *hfsConfig != '\0') {
+    if (srv_use_native_aio) {
+      fprintf(stderr, "hfs_vfs: native AIO is unsupported\n");
+      return 1;
+    }
+    if (!hfs_vfs::init()) {
+      fprintf(stderr, "hfs_vfs: initialization failed\n");
+      return 1;
+    }
+  }
 
   acquire_plugin_services();
