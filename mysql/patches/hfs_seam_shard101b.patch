+int read(int handle, void *buf, std::size_t n, std::uint64_t offset,
+         std::size_t *out);
+int write(int handle, const void *buf, std::size_t n, std::uint64_t offset,
+          std::size_t *out);
+int flush(int handle);
+std::uint64_t size(int handle);
+int setSize(int handle, std::uint64_t size, bool flush);
+int truncate(int handle, std::uint64_t size);
+int punchHole(int handle, std::uint64_t offset, std::uint64_t length);
+int lock(int handle);
+
+/* Path operations; status returns false when the path cannot be resolved and
+ * writes the os_file_type_t-compatible value otherwise. */
+bool status(const char *path, bool *exists, int *type, std::uint64_t *size,
+            std::uint64_t *allocSize, bool *rwPerm);
+bool exists(const char *path);
+int deleteFile(const char *path, bool *existed);
+int renameFile(const char *from, const char *to);
+int createDirectory(const char *path, bool failIfExists);
+int deleteDirectory(const char *path);
+int scanDirectory(const char *path,
+                  const std::function<void(const char *, const char *)> &cb);
+std::uint64_t freeSpace();
+
+/* mysys (server layer) helpers: POSIX-flag open, struct stat synthesis,
+ * sequential I/O with a per-handle file position, seek/chsize/access. */
+int openPath(const char *path, int flags, int mode);
+int statPath(const char *path, struct stat *st);
+int fstatHandle(int handle, struct stat *st);
+int accessPath(const char *path, int amode);
+int realpathPath(char *to, const char *from, std::size_t toSize);
+int readHandle(int handle, void *buf, std::size_t n, std::size_t *out);
+int writeHandle(int handle, const void *buf, std::size_t n, std::size_t *out);
+int seekHandle(int handle, std::int64_t offset, int whence,
+               std::uint64_t *position);
+int chsizeHandle(int handle, std::uint64_t length, int filler);
+
+/* Read-only FILE stream for stdio-based config readers (auto.cnf). */
+FILE *fopenRead(const char *path);
+
+/* Write FILE stream for stdio writers (SSL key files, config dumps). */
+FILE *fopenWrite(const char *path);
+
+} // namespace hfs_vfs
