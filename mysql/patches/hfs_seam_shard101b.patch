diff --git a/storage/innobase/os/hfs_vfs.cc b/storage/innobase/os/hfs_vfs.cc
new file mode 100644
index 00000000..96af4f2c
--- /dev/null
+++ b/storage/innobase/os/hfs_vfs.cc
@@ -0,0 +1,1053 @@
+/* HFS-backed InnoDB os_file seam implementation (Phase 7, Shard-101). */
+#include "hfs_vfs.h"
+
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fcntl.h>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <string_view>
+#include <unistd.h>
+#include <vector>
+
+#include "hfs/config.hpp"
+#include "hfs/core.hpp"
+#include "hfs/file.hpp"
+
+namespace hfs_vfs {
+namespace {
+
+/* os_file_create_t values are a frozen ABI in MySQL 8.0; keep them local so
+ * this module does not depend on the InnoDB headers. */
+constexpr unsigned long kModeOpen = 51;
+constexpr unsigned long kModeCreate = 52;
+constexpr unsigned long kModeOpenRaw = 53;
+constexpr unsigned long kModeCreatePath = 54;
+constexpr unsigned long kModeOpenRetry = 55;
+/* Pseudo mode used by os_file_create_simple_no_error_handling: create the file
+ * when missing without O_EXCL semantics. */
+constexpr unsigned long kModeCreateIfMissing = 0;
+constexpr unsigned long kModeOnErrorNoExit = 128;
+constexpr unsigned long kModeOnErrorSilent = 256;
+
+/* os_file_type_t values used by os_file_status_posix. */
+constexpr int kTypeFailed = 0;
+constexpr int kTypeMissing = 3;
+constexpr int kTypeFile = 5;
+constexpr int kTypeDir = 6;
+
+struct BridgeState {
+  bool enabled = false;
+  std::string prefix = "/hfs";
+  std::string logicalCwd;
+  std::unique_ptr<hfs::Engine> engine;
+  std::once_flag initOnce;
+  std::mutex mutex;
+  struct Entry {
+    std::shared_ptr<hfs::File> file;
+    std::uint64_t position = 0;
+  };
+  std::vector<Entry> handles;
+  std::vector<int> freeHandles;
+};
+
+BridgeState &state() {
+  static BridgeState bridge;
+  return bridge;
+}
+
+thread_local std::shared_ptr<hfs::Client> t_client;
+
+void setErrno(hfs::Status status) {
+  switch (status) {
+    case hfs::Status::NotFound:
+      errno = ENOENT;
+      break;
+    case hfs::Status::AlreadyExists:
+      errno = EEXIST;
+      break;
+    case hfs::Status::NoSpace:
+      errno = ENOSPC;
+      break;
+    case hfs::Status::NoMemory:
+      errno = ENOMEM;
+      break;
+    case hfs::Status::InvalidArgument:
+      errno = EINVAL;
+      break;
+    case hfs::Status::Busy:
+      errno = EBUSY;
+      break;
+    case hfs::Status::Cancelled:
+      errno = ECANCELED;
+      break;
+    case hfs::Status::TimedOut:
+      errno = ETIMEDOUT;
+      break;
+    case hfs::Status::NotSupported:
+      errno = EOPNOTSUPP;
+      break;
+    default:
+      errno = EIO;
+      break;
+  }
+}
+
+/* Resolves a possibly relative host path and normalizes it. */
+bool normalizeHostPath(const char *path, std::string &norm) {
+  if (path == nullptr || *path == '\0') {
+    return false;
+  }
+  std::string host;
+  if (path[0] == '/') {
+    host.assign(path);
+  } else {
+    BridgeState &bridge = state();
+    if (!bridge.logicalCwd.empty()) {
+      host.assign(bridge.logicalCwd);
+    } else {
+      char cwd[4096];
+      if (::getcwd(cwd, sizeof(cwd)) == nullptr) {
+        return false;
+      }
+      host.assign(cwd);
+    }
+    if (host.empty() || host.back() != '/') {
+      host += '/';
+    }
+    host += path;
+  }
+  norm.clear();
+  norm.reserve(host.size());
+  std::size_t start = 0;
+  while (start <= host.size()) {
+    std::size_t slash = host.find('/', start);
+    if (slash == std::string::npos) {
+      slash = host.size();
+    }
+    const std::string_view part(host.data() + start, slash - start);
+    if (part.empty() || part == ".") {
+      /* skip */
+    } else if (part == "..") {
+      const std::size_t pos = norm.find_last_of('/');
+      norm.resize(pos == std::string::npos ? 0 : pos);
+    } else {
+      norm += '/';
+      norm.append(part);
+    }
+    if (slash == host.size()) {
+      break;
+    }
+    start = slash + 1;
+  }
+  if (norm.empty()) {
+    norm = "/";
+  }
+  return true;
+}
+
+/* Maps a host path below HFS_MYSQL_PREFIX to its HFS namespace path. Relative
+ * paths are resolved against the current working directory because MySQL
+ * chdir()s to the datadir before InnoDB opens its files. */
+bool toNamespacePath(const char *path, std::string &out) {
+  BridgeState &bridge = state();
+  if (!bridge.enabled) {
+    return false;
+  }
+  std::string norm;
+  if (!normalizeHostPath(path, norm)) {
+    return false;
+  }
+  const std::string_view prefix(bridge.prefix);
+  if (norm.size() < prefix.size() ||
+      norm.compare(0, prefix.size(), prefix) != 0) {
+    return false;
+  }
+  if (norm.size() != prefix.size() && norm[prefix.size()] != '/') {
+    return false;
+  }
+  out.assign(norm.substr(prefix.size()));
+  if (out.empty()) {
+    out = "/";
+  }
+  return true;
+}
+
+std::shared_ptr<hfs::Client> threadClient() {
+  if (t_client) {
+    return t_client;
+  }
+  BridgeState &bridge = state();
+  if (!bridge.enabled || bridge.engine == nullptr) {
+    return nullptr;
+  }
+  auto created = hfs::Client::create(*bridge.engine, hfs::ClientOptions{});
+  if (!created.ok()) {
+    return nullptr;
+  }
+  t_client = created.value();
+  return t_client;
+}
+
+int registerHandle(const std::shared_ptr<hfs::File> &file) {
+  BridgeState &bridge = state();
+  std::lock_guard<std::mutex> lock(bridge.mutex);
+  int index = 0;
+  if (!bridge.freeHandles.empty()) {
+    index = bridge.freeHandles.back();
+    bridge.freeHandles.pop_back();
+    bridge.handles[static_cast<std::size_t>(index)] =
+        BridgeState::Entry{file, 0};
+  } else {
+    index = static_cast<int>(bridge.handles.size());
+    bridge.handles.push_back(BridgeState::Entry{file, 0});
+  }
+  return kHandleBase + index;
+}
+
+std::shared_ptr<hfs::File> lookupHandle(int handle) {
+  BridgeState &bridge = state();
+  if (handle < kHandleBase) {
+    return nullptr;
+  }
+  const int index = handle - kHandleBase;
+  std::lock_guard<std::mutex> lock(bridge.mutex);
+  if (index < 0 || static_cast<std::size_t>(index) >= bridge.handles.size()) {
+    return nullptr;
+  }
+  return bridge.handles[static_cast<std::size_t>(index)].file;
+}
+
+std::uint64_t positionFor(int handle) {
+  BridgeState &bridge = state();
+  if (handle < kHandleBase) {
+    return 0;
+  }
+  const int index = handle - kHandleBase;
+  std::lock_guard<std::mutex> lock(bridge.mutex);
+  if (index < 0 || static_cast<std::size_t>(index) >= bridge.handles.size()) {
+    return 0;
+  }
+  return bridge.handles[static_cast<std::size_t>(index)].position;
+}
+
+void setPosition(int handle, std::uint64_t position) {
+  BridgeState &bridge = state();
+  if (handle < kHandleBase) {
+    return;
+  }
+  const int index = handle - kHandleBase;
+  std::lock_guard<std::mutex> lock(bridge.mutex);
+  if (index < 0 || static_cast<std::size_t>(index) >= bridge.handles.size()) {
+    return;
+  }
+  bridge.handles[static_cast<std::size_t>(index)].position = position;
+}
+
+void releaseHandle(int handle) {
+  BridgeState &bridge = state();
+  if (handle < kHandleBase) {
+    return;
+  }
+  const int index = handle - kHandleBase;
+  std::lock_guard<std::mutex> lock(bridge.mutex);
+  if (index < 0 || static_cast<std::size_t>(index) >= bridge.handles.size()) {
+    return;
+  }
+  bridge.handles[static_cast<std::size_t>(index)] = BridgeState::Entry{};
+  bridge.freeHandles.push_back(index);
+}
+
+std::string parentPath(const std::string &path) {
+  const std::size_t slash = path.find_last_of('/');
+  if (slash == std::string::npos || slash == 0) {
+    return "/";
+  }
+  return path.substr(0, slash);
+}
+
+} // namespace
+
+bool isHfsHandle(int handle) { return handle >= kHandleBase; }
+
+bool init() {
+  std::call_once(state().initOnce, [] {
+    BridgeState &bridge = state();
+    const char *config = std::getenv("HFS_MYSQL_CONFIG");
+    if (config == nullptr || *config == '\0') {
+      bridge.enabled = false;
+      return;
+    }
+    const char *prefix = std::getenv("HFS_MYSQL_PREFIX");
+    if (prefix != nullptr && *prefix != '\0') {
+      bridge.prefix = prefix;
+    }
+    while (bridge.prefix.size() > 1 && bridge.prefix.back() == '/') {
+      bridge.prefix.pop_back();
+    }
+    auto parsed = hfs::parseConfigFile(config);
+    if (!parsed.ok()) {
+      std::fprintf(stderr, "hfs_vfs: config %s rejected: %s\n", config,
+                   parsed.message().c_str());
+      bridge.enabled = false;
+      return;
+    }
+    auto created = hfs::Engine::create(parsed.value());
+    if (!created.ok()) {
+      std::fprintf(stderr, "hfs_vfs: engine create failed: %s\n",
+                   created.message().c_str());
+      bridge.enabled = false;
+      return;
+    }
+    bridge.engine = std::move(created).value();
+    auto mounted = bridge.engine->mount().wait().value();
+    if (!mounted.ok()) {
+      std::fprintf(stderr, "hfs_vfs: mount failed: %s\n",
+                   mounted.message().c_str());
+      bridge.engine.reset();
+      bridge.enabled = false;
+      return;
+    }
+    bridge.enabled = true;
+    std::fprintf(stderr, "hfs_vfs: mounted %s (prefix %s)\n", config,
+                 bridge.prefix.c_str());
+  });
+  return state().enabled;
+}
+
+void shutdown() {
+  BridgeState &bridge = state();
+  if (!bridge.enabled || bridge.engine == nullptr) {
+    return;
+  }
+  if (t_client) {
+    t_client->close().wait();
+    t_client.reset();
+  }
+  {
+    std::lock_guard<std::mutex> lock(bridge.mutex);
+    bridge.handles.clear();
+    bridge.freeHandles.clear();
+  }
+  auto stopped = bridge.engine->stop().wait().value();
+  if (!stopped.ok()) {
+    std::fprintf(stderr, "hfs_vfs: engine stop failed: %s\n",
+                 stopped.message().c_str());
+  }
+  bridge.enabled = false;
+  /* The engine object is intentionally kept alive until process exit so that
+   * late thread-local client destructors never observe a freed engine. */
+}
+
+bool pathIsHfs(const char *path) {
+  if (!init()) {
+    return false;
+  }
+  std::string namespacePath;
+  return toNamespacePath(path, namespacePath);
+}
+
+void setCwd(const char *path) {
+  BridgeState &bridge = state();
+  std::string norm;
+  if (!normalizeHostPath(path, norm)) {
+    return;
+  }
+  const std::string_view prefix(bridge.prefix);
+  if (norm.size() >= prefix.size() &&
+      norm.compare(0, prefix.size(), prefix) == 0 &&
+      (norm.size() == prefix.size() || norm[prefix.size()] == '/')) {
+    bridge.logicalCwd = norm;
+  } else {
+    bridge.logicalCwd.clear();
+  }
+}
+
+int createFile(const char *path, unsigned long create_mode, bool read_only,
+               int *handle) {
+  (void)read_only;
+  BridgeState &bridge = state();
+  if (!bridge.enabled) {
+    errno = ENOENT;
+    return -1;
+  }
+  create_mode &= ~kModeOnErrorNoExit;
+  create_mode &= ~kModeOnErrorSilent;
+  std::string namespacePath;
+  if (!toNamespacePath(path, namespacePath)) {
+    errno = ENOENT;
+    return -1;
+  }
+  auto client = threadClient();
+  if (!client) {
+    errno = EIO;
+    return -1;
+  }
+  hfs::OpenFlags flags = hfs::OpenFlags::None;
+  if (create_mode == kModeOpen || create_mode == kModeOpenRetry) {
+    flags = hfs::OpenFlags::None;
+  } else if (create_mode == kModeCreateIfMissing) {
+    flags = hfs::OpenFlags::Create;
+  } else if (create_mode == kModeCreate) {
+    flags = hfs::OpenFlags::Create | hfs::OpenFlags::Exclusive;
+  } else if (create_mode == kModeCreatePath) {
+    flags = hfs::OpenFlags::Create | hfs::OpenFlags::Exclusive;
+    auto made = client->createDirectories(parentPath(namespacePath)).wait().value();
+    if (!made.ok()) {
+      setErrno(made.status());
+      return -1;
+    }
+  } else {
+    (void)kModeOpenRaw;
+    errno = EINVAL; /* raw devices are not supported on HFS */
+    return -1;
+  }
+  auto opened = client->open(namespacePath, flags).wait().value();
+  if (!opened.ok() && opened.status() == hfs::Status::NotFound &&
+      static_cast<std::uint32_t>(flags) != 0) {
+    /* MySQL creates the host datadir itself; mirror the namespace parents on
+     * the first create below a missing directory (e.g. the datadir root). */
+    auto made =
+        client->createDirectories(parentPath(namespacePath)).wait().value();
+    if (made.ok()) {
+      opened = client->open(namespacePath, flags).wait().value();
+    }
+  }
+  if (!opened.ok()) {
+    setErrno(opened.status());
+    return -1;
+  }
+  auto stat = opened.value()->stat();
+  if (stat.ok() && stat.value().directory) {
+    errno = EISDIR;
+    return -1;
+  }
+  *handle = registerHandle(opened.value());
+  return 0;
+}
+
+int close(int handle) {
+  if (lookupHandle(handle) == nullptr) {
+    errno = EBADF;
+    return -1;
+  }
+  releaseHandle(handle);
+  return 0;
+}
+
+int read(int handle, void *buf, std::size_t n, std::uint64_t offset,
+         std::size_t *out) {
+  auto file = lookupHandle(handle);
+  if (!file) {
+    errno = EBADF;
+    return -1;
+  }
+  hfs::IoVec vec{static_cast<std::byte *>(buf), n};
+  auto result =
+      file->read(std::span<hfs::IoVec>(&vec, 1), offset, std::stop_token{})
+          .wait()
+          .value();
+  if (!result.ok()) {
+    setErrno(result.status());
+    return -1;
+  }
+  *out = result.value().bytes;
+  return 0;
+}
+
+int write(int handle, const void *buf, std::size_t n, std::uint64_t offset,
+          std::size_t *out) {
+  auto file = lookupHandle(handle);
+  if (!file) {
+    errno = EBADF;
+    return -1;
+  }
+  hfs::IoVec vec{const_cast<std::byte *>(static_cast<const std::byte *>(buf)), n};
+  auto result =
+      file->write(std::span<const hfs::IoVec>(&vec, 1), offset, std::stop_token{})
+          .wait()
+          .value();
+  if (!result.ok()) {
+    setErrno(result.status());
+    return -1;
+  }
+  *out = result.value().bytes;
+  return 0;
+}
+
+int flush(int handle) {
+  auto file = lookupHandle(handle);
+  if (!file) {
+    errno = EBADF;
+    return -1;
+  }
+  auto result = file->sync().wait().value();
+  if (!result.ok()) {
+    setErrno(result.status());
+    return -1;
+  }
+  return 0;
+}
+
+std::uint64_t size(int handle) {
+  auto file = lookupHandle(handle);
+  if (!file) {
+    errno = EBADF;
+    return static_cast<std::uint64_t>(-1);
+  }
+  auto stat = file->stat();
+  if (!stat.ok()) {
+    setErrno(stat.status());
+    return static_cast<std::uint64_t>(-1);
+  }
+  return stat.value().logicalSize;
+}
+
+int setSize(int handle, std::uint64_t newSize, bool flushAfter) {
+  auto file = lookupHandle(handle);
+  if (!file) {
+    errno = EBADF;
+    return -1;
+  }
+  auto stat = file->stat();
+  if (!stat.ok()) {
+    setErrno(stat.status());
+    return -1;
+  }
+  const std::uint64_t current = stat.value().logicalSize;
+  if (newSize > current) {
+    auto grown = file->allocate(current, newSize - current).wait().value();
+    if (!grown.ok()) {
+      setErrno(grown.status());
+      return -1;
+    }
+  } else if (newSize < current) {
+    auto shrunk = file->truncate(newSize).wait().value();
+    if (!shrunk.ok()) {
+      setErrno(shrunk.status());
+      return -1;
+    }
+  }
+  if (flushAfter) {
+    return flush(handle);
+  }
+  return 0;
+}
+
+int truncate(int handle, std::uint64_t newSize) {
+  auto file = lookupHandle(handle);
+  if (!file) {
+    errno = EBADF;
+    return -1;
+  }
+  auto result = file->truncate(newSize).wait().value();
+  if (!result.ok()) {
+    setErrno(result.status());
+    return -1;
+  }
+  return 0;
+}
+
+int punchHole(int handle, std::uint64_t offset, std::uint64_t length) {
+  (void)handle;
+  (void)offset;
+  (void)length;
+  errno = EOPNOTSUPP; /* page compression stays disabled on HFS */
+  return -1;
+}
+
+int lock(int handle) {
+  (void)handle;
+  return 0; /* HFS enforces single-instance exclusivity itself */
+}
+
+bool status(const char *path, bool *existsOut, int *type, std::uint64_t *sizeOut,
+            std::uint64_t *allocSizeOut, bool *rwPerm) {
+  if (!state().enabled) {
+    return false;
+  }
+  std::string namespacePath;
+  if (!toNamespacePath(path, namespacePath)) {
+    return false;
+  }
+  auto client = threadClient();
+  if (!client) {
+    return false;
+  }
+  auto stat = client->stat(namespacePath).wait().value();
+  if (!stat.ok()) {
+    if (stat.status() == hfs::Status::NotFound) {
+      if (existsOut != nullptr) {
+        *existsOut = false;
+      }
+      if (type != nullptr) {
+        *type = kTypeMissing;
+      }
+      return true;
+    }
+    if (existsOut != nullptr) {
+      *existsOut = false;
+    }
+    if (type != nullptr) {
+      *type = kTypeFailed;
+    }
+    return false;
+  }
+  if (existsOut != nullptr) {
+    *existsOut = true;
+  }
+  if (type != nullptr) {
+    *type = stat.value().directory ? kTypeDir : kTypeFile;
+  }
+  if (sizeOut != nullptr) {
+    *sizeOut = stat.value().logicalSize;
+  }
+  if (allocSizeOut != nullptr) {
+    *allocSizeOut = stat.value().logicalSize;
+  }
+  if (rwPerm != nullptr) {
+    *rwPerm = true;
+  }
+  return true;
+}
+
+bool exists(const char *path) {
+  bool present = false;
+  if (!status(path, &present, nullptr, nullptr, nullptr, nullptr)) {
+    return false;
+  }
+  return present;
+}
+
+int deleteFile(const char *path, bool *existed) {
+  std::string namespacePath;
+  if (!toNamespacePath(path, namespacePath)) {
+    errno = ENOENT;
+    return -1;
+  }
+  auto client = threadClient();
+  if (!client) {
+    errno = EIO;
+    return -1;
+  }
+  auto result = client->remove(namespacePath).wait().value();
+  if (!result.ok()) {
+    if (result.status() == hfs::Status::NotFound) {
+      if (existed != nullptr) {
+        *existed = false;
+      }
+      return 0;
+    }
+    setErrno(result.status());
+    return -1;
+  }
+  if (existed != nullptr) {
+    *existed = true;
+  }
+  return 0;
+}
+
+int renameFile(const char *from, const char *to) {
+  std::string fromPath;
+  std::string toPath;
+  if (!toNamespacePath(from, fromPath) || !toNamespacePath(to, toPath)) {
+    errno = ENOENT;
+    return -1;
+  }
+  auto client = threadClient();
+  if (!client) {
+    errno = EIO;
+    return -1;
+  }
+  auto result = client->rename(fromPath, toPath).wait().value();
+  if (!result.ok()) {
+    setErrno(result.status());
+    return -1;
+  }
+  return 0;
+}
+
+int createDirectory(const char *path, bool failIfExists) {
+  std::string namespacePath;
+  if (!toNamespacePath(path, namespacePath)) {
+    errno = ENOENT;
+    return -1;
+  }
+  auto client = threadClient();
+  if (!client) {
+    errno = EIO;
+    return -1;
+  }
+  if (failIfExists) {
+    auto stat = client->stat(namespacePath).wait().value();
+    if (stat.ok()) {
+      errno = EEXIST;
+      return -1;
+    }
+  }
+  auto result = client->createDirectories(namespacePath).wait().value();
+  if (!result.ok()) {
+    setErrno(result.status());
+    return -1;
+  }
+  return 0;
+}
+
+int deleteDirectory(const char *path) {
+  std::string namespacePath;
+  if (!toNamespacePath(path, namespacePath)) {
+    errno = ENOENT;
+    return -1;
+  }
+  auto client = threadClient();
+  if (!client) {
+    errno = EIO;
+    return -1;
+  }
+  auto result = client->remove(namespacePath).wait().value();
+  if (!result.ok()) {
+    setErrno(result.status());
+    return -1;
+  }
+  return 0;
+}
+
+int scanDirectory(const char *path,
+                  const std::function<void(const char *, const char *)> &cb) {
+  std::string namespacePath;
+  if (!toNamespacePath(path, namespacePath)) {
+    errno = ENOENT;
+    return -1;
+  }
+  auto client = threadClient();
+  if (!client) {
+    errno = EIO;
+    return -1;
+  }
+  std::string cursor;
+  for (;;) {
+    auto page = client->getChildren(namespacePath, cursor, 256).wait().value();
+    if (!page.ok()) {
+      setErrno(page.status());
+      return -1;
+    }
+    for (const hfs::DirectoryEntry &entry : page.value().entries) {
+      std::string full = state().prefix;
+      if (namespacePath != "/") {
+        full += namespacePath;
+      }
+      if (full.empty() || full.back() != '/') {
+        full += '/';
+      }
+      full += entry.name;
+      cb(full.c_str(), entry.name.c_str());
+    }
+    if (page.value().nextCursor.empty()) {
+      break;
+    }
+    cursor = page.value().nextCursor;
+  }
+  return 0;
+}
+
+std::uint64_t freeSpace() {
+  BridgeState &bridge = state();
+  if (!bridge.enabled || bridge.engine == nullptr) {
+    return 0;
+  }
+  return bridge.engine->freeDataBytes();
+}
+
+/* --- mysys (server layer) helpers --- */
+
+void fillStat(const hfs::FileStat &source, struct stat *st) {
+  std::memset(st, 0, sizeof(*st));
+  st->st_mode = source.directory ? (S_IFDIR | 0755) : (S_IFREG | 0644);
+  st->st_size = static_cast<off_t>(source.logicalSize);
+  st->st_nlink = 1;
+  st->st_blocks = static_cast<blkcnt_t>((source.logicalSize + 511) / 512);
+  st->st_blksize = 4096;
+  st->st_uid = ::getuid();
+  st->st_gid = ::getgid();
+  st->st_mtime = 0;
+  st->st_ctime = 0;
+  st->st_atime = 0;
+}
+
+/* POSIX-flag open used by my_open/my_create; supports O_CREAT/O_EXCL/O_TRUNC. */
+int openPath(const char *path, int flags, int mode) {
+  (void)mode;
+  BridgeState &bridge = state();
+  if (!bridge.enabled) {
+    errno = ENOENT;
+    return -1;
+  }
+  std::string namespacePath;
+  if (!toNamespacePath(path, namespacePath)) {
+    errno = ENOENT;
+    return -1;
+  }
+  auto client = threadClient();
+  if (!client) {
+    errno = EIO;
+    return -1;
+  }
+  hfs::OpenFlags openFlags = hfs::OpenFlags::None;
+  if ((flags & O_CREAT) != 0) {
+    openFlags = openFlags | hfs::OpenFlags::Create;
+  }
+  if ((flags & O_EXCL) != 0) {
+    openFlags = openFlags | hfs::OpenFlags::Exclusive;
+  }
+  auto opened = client->open(namespacePath, openFlags).wait().value();
+  if (!opened.ok() && opened.status() == hfs::Status::NotFound &&
+      (flags & O_CREAT) != 0) {
+    auto made =
+        client->createDirectories(parentPath(namespacePath)).wait().value();
+    if (made.ok()) {
+      opened = client->open(namespacePath, openFlags).wait().value();
+    }
+  }
+  if (!opened.ok()) {
+    setErrno(opened.status());
+    return -1;
+  }
+  auto stat = opened.value()->stat();
+  if (stat.ok() && stat.value().directory) {
+    errno = EISDIR;
+    return -1;
+  }
+  if ((flags & O_TRUNC) != 0 && (flags & O_CREAT) == 0) {
+    auto truncated = opened.value()->truncate(0).wait().value();
+    if (!truncated.ok()) {
+      setErrno(truncated.status());
+      return -1;
+    }
+  }
+  return registerHandle(opened.value());
+}
+
+int statPath(const char *path, struct stat *st) {
+  if (!state().enabled) {
+    errno = ENOENT;
+    return -1;
+  }
+  std::string namespacePath;
+  if (!toNamespacePath(path, namespacePath)) {
+    errno = ENOENT;
+    return -1;
+  }
+  auto client = threadClient();
+  if (!client) {
+    errno = EIO;
+    return -1;
+  }
+  auto stat = client->stat(namespacePath).wait().value();
+  if (!stat.ok()) {
+    setErrno(stat.status());
+    return -1;
+  }
+  fillStat(stat.value(), st);
+  return 0;
+}
+
+int fstatHandle(int handle, struct stat *st) {
+  auto file = lookupHandle(handle);
+  if (!file) {
+    errno = EBADF;
+    return -1;
+  }
+  auto stat = file->stat();
+  if (!stat.ok()) {
+    setErrno(stat.status());
+    return -1;
+  }
+  fillStat(stat.value(), st);
+  return 0;
+}
+
+int accessPath(const char *path, int amode) {
+  (void)amode;
+  struct stat st;
+  return statPath(path, &st);
+}
+
+int realpathPath(char *to, const char *from, std::size_t toSize) {
+  if (!state().enabled || to == nullptr || from == nullptr) {
+    errno = EINVAL;
+    return -1;
+  }
+  std::string norm;
+  if (!normalizeHostPath(from, norm)) {
+    errno = EINVAL;
+    return -1;
+  }
+  std::string namespacePath;
+  if (!toNamespacePath(norm.c_str(), namespacePath)) {
+    errno = ENOENT;
+    return -1;
+  }
+  if (norm.size() + 1 > toSize) {
+    errno = ENAMETOOLONG;
+    return -1;
+  }
+  std::memcpy(to, norm.c_str(), norm.size() + 1);
+  return 0;
+}
+
+int readHandle(int handle, void *buf, std::size_t n, std::size_t *out) {
+  const std::uint64_t position = positionFor(handle);
+  const int rc = read(handle, buf, n, position, out);
+  if (rc == 0) {
+    setPosition(handle, position + *out);
+  }
+  return rc;
+}
+
+int writeHandle(int handle, const void *buf, std::size_t n, std::size_t *out) {
+  const std::uint64_t position = positionFor(handle);
+  const int rc = write(handle, buf, n, position, out);
+  if (rc == 0) {
+    setPosition(handle, position + *out);
+  }
+  return rc;
+}
+
+int seekHandle(int handle, std::int64_t offset, int whence,
+               std::uint64_t *position) {
+  std::uint64_t base = 0;
+  if (whence == SEEK_CUR) {
+    base = positionFor(handle);
+  } else if (whence == SEEK_END) {
+    const std::uint64_t end = size(handle);
+    if (end == static_cast<std::uint64_t>(-1)) {
+      return -1;
+    }
+    base = end;
+  } else if (whence != SEEK_SET) {
+    errno = EINVAL;
+    return -1;
+  }
+  const std::int64_t result = static_cast<std::int64_t>(base) + offset;
+  if (result < 0) {
+    errno = EINVAL;
+    return -1;
+  }
+  setPosition(handle, static_cast<std::uint64_t>(result));
+  *position = static_cast<std::uint64_t>(result);
+  return 0;
+}
+
+int chsizeHandle(int handle, std::uint64_t length, int filler) {
+  (void)filler;
+  auto file = lookupHandle(handle);
+  if (!file) {
+    errno = EBADF;
+    return -1;
+  }
+  auto stat = file->stat();
+  if (!stat.ok()) {
+    setErrno(stat.status());
+    return -1;
+  }
+  const std::uint64_t current = stat.value().logicalSize;
+  if (length < current) {
+    auto result = file->truncate(length).wait().value();
+    if (!result.ok()) {
+      setErrno(result.status());
+      return -1;
+    }
+  } else if (length > current) {
+    auto result = file->allocate(current, length - current).wait().value();
+    if (!result.ok()) {
+      setErrno(result.status());
+      return -1;
+    }
+  }
+  return 0;
+}
+
+/* glibc cookie stream so stdio readers (my_load_defaults/auto.cnf) can read
+ * HFS files without a host fd. */
+FILE *fopenRead(const char *path) {
+  const int handle = openPath(path, O_RDONLY, 0);
+  if (handle < 0) {
+    return nullptr;
+  }
+  struct Cookie {
+    int handle;
+  };
+  Cookie *cookie = new (std::nothrow) Cookie{handle};
+  if (cookie == nullptr) {
+    close(handle);
+    errno = ENOMEM;
+    return nullptr;
+  }
+  cookie_io_functions_t io{};
+  io.read = [](void *context, char *buffer, std::size_t size) -> ssize_t {
+    Cookie *self = static_cast<Cookie *>(context);
+    std::size_t done = 0;
+    if (readHandle(self->handle, buffer, size, &done) != 0) {
+      return -1;
+    }
+    return static_cast<ssize_t>(done);
+  };
+  io.close = [](void *context) -> int {
+    Cookie *self = static_cast<Cookie *>(context);
+    close(self->handle);
+    delete self;
+    return 0;
+  };
+  FILE *stream = ::fopencookie(cookie, "r", io);
+  if (stream == nullptr) {
+    close(handle);
+    delete cookie;
+  }
+  return stream;
+}
+
+/* Write-mode cookie stream for stdio writers (SSL keys, config dumps). */
+FILE *fopenWrite(const char *path) {
+  const int handle = openPath(path, O_WRONLY | O_CREAT | O_TRUNC, 0600);
+  if (handle < 0) {
+    return nullptr;
+  }
+  struct Cookie {
+    int handle;
+  };
+  Cookie *cookie = new (std::nothrow) Cookie{handle};
+  if (cookie == nullptr) {
+    close(handle);
+    errno = ENOMEM;
+    return nullptr;
+  }
+  cookie_io_functions_t io{};
+  io.write = [](void *context, const char *buffer,
+                std::size_t size) -> ssize_t {
+    Cookie *self = static_cast<Cookie *>(context);
+    std::size_t done = 0;
+    if (writeHandle(self->handle, buffer, size, &done) != 0 ||
+        done != size) {
+      return -1;
+    }
+    return static_cast<ssize_t>(done);
+  };
+  io.close = [](void *context) -> int {
+    Cookie *self = static_cast<Cookie *>(context);
+    flush(self->handle);
+    close(self->handle);
+    delete self;
+    return 0;
+  };
+  FILE *stream = ::fopencookie(cookie, "w", io);
+  if (stream == nullptr) {
+    close(handle);
+    delete cookie;
+  }
+  return stream;
+}
+
+} // namespace hfs_vfs
