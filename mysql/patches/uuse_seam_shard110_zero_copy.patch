+/* Allocates one large DMA-capable block for the InnoDB buffer pool. */
+void *allocDmaBuffer(std::size_t size) {
+  BridgeState &bridge = state();
+  if (!bridge.enabled || bridge.engine == nullptr || size == 0) {
+    return nullptr;
+  }
+  auto result = bridge.engine->acquireDmaBuffer(size, 0);
+  if (!result.ok()) {
+    std::fprintf(stderr,
+                 "uuse_vfs: dma pool allocation failed (%zu bytes): %s\n", size,
+                 result.message().c_str());
+    return nullptr;
+  }
+  return result.value().data();
+}
+
+/* Returns a block obtained from allocDmaBuffer() to the engine arena. */
+void freeDmaBuffer(void *ptr, std::size_t size) {
+  BridgeState &bridge = state();
+  if (!bridge.enabled || bridge.engine == nullptr || ptr == nullptr ||
+      size == 0) {
+    return;
+  }
+  bridge.engine->releaseDmaBuffer(ptr, size);
+}
