+/* UUSE-backed InnoDB os_file seam (Phase 7, Shard-101).
+ *
+ * Standalone bridge between MySQL's os_file layer and the UUSE C++ core. The
+ * module owns the engine lifecycle, the path routing and an integer handle
+ * table; os0file.cc only dispatches into it. Host POSIX paths are untouched. */
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+
+namespace uuse_vfs {
+
+/* Handles are indices encoded above any real fd so both can coexist. */
+constexpr int kHandleBase = 0x40000000;
+
+bool isUuseHandle(int handle);
+
+/* Mounts the UUSE volume from UUSE_MYSQL_CONFIG when the path is routed.
+ * Returns true when the bridge is enabled. */
+bool init();
+void shutdown();
+
+/* True when the bridge is enabled and the host path is below UUSE_MYSQL_PREFIX
+ * (default "/uuse"); the UUSE namespace path is the prefix-stripped remainder. */
+bool pathIsUuse(const char *path);
+
+/* File lifecycle. create_mode is os_file_create_t; returns 0 on success and
+ * stores the handle. */
+int createFile(const char *path, unsigned long create_mode, bool read_only,
+               int *handle);
+int close(int handle);
+
+/* Positioned I/O; returns 0 on success and stores the transferred bytes. */
+int read(int handle, void *buf, std::size_t n, std::uint64_t offset,
+         std::size_t *out);
+int write(int handle, const void *buf, std::size_t n, std::uint64_t offset,
+          std::size_t *out);
+int flush(int handle);
+std::uint64_t size(int handle);
+int setSize(int handle, std::uint64_t size, bool flush);
+int truncate(int handle, std::uint64_t size);
+int punchHole(int handle, std::uint64_t offset, std::uint64_t length);
+int lock(int handle);
+
+/* Path operations; status returns false when the path cannot be resolved and
+ * writes the os_file_type_t-compatible value otherwise. */
+bool status(const char *path, bool *exists, int *type, std::uint64_t *size,
+            std::uint64_t *allocSize, bool *rwPerm);
+bool exists(const char *path);
+int deleteFile(const char *path, bool *existed);
+int renameFile(const char *from, const char *to);
+int createDirectory(const char *path, bool failIfExists);
+int deleteDirectory(const char *path);
+int scanDirectory(const char *path,
+                  const std::function<void(const char *, const char *)> &cb);
+std::uint64_t freeSpace();
+
+} // namespace uuse_vfs
