+/* Runs one I/O through the per-thread async frontend and polls for its
+ * completion on this thread. Returns false when the async path cannot be used
+ * (nothing was submitted), so the caller falls back to the sync facade. */
+bool asyncIo(const std::string &path, void *buf, std::size_t n, std::uint64_t offset,
+             bool write, std::size_t *out, int *errorOut) {
