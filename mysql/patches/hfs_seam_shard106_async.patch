+/* Returns the namespace path of one open handle (empty when unavailable). */
+std::string handlePath(int handle) {
+  BridgeState &bridge = state();
+  if (handle < kHandleBase) {
+    return {};
+  }
+  const int index = handle - kHandleBase;
+  std::lock_guard<std::mutex> lock(bridge.mutex);
+  if (index < 0 || static_cast<std::size_t>(index) >= bridge.handles.size()) {
+    return {};
+  }
+  return bridge.handles[static_cast<std::size_t>(index)].path;
+}
+
+/* Returns the calling thread's File for a namespace path, opening it with the
+ * thread client on first use: the async frontend only accepts I/O for files
+ * owned by the same client. */
+std::shared_ptr<hfs::File> threadFile(const std::string &path) {
+  ThreadClientHolder *holder = t_holder.get();
+  if (holder == nullptr || holder->client == nullptr || path.empty()) {
+    return nullptr;
+  }
+  auto found = holder->files.find(path);
+  if (found != holder->files.end()) {
+    return found->second;
+  }
+  auto opened = holder->client->open(path).wait().value();
+  if (!opened.ok()) {
+    return nullptr;
+  }
+  auto file = opened.value();
+  holder->files.emplace(path, file);
+  return file;
+}
