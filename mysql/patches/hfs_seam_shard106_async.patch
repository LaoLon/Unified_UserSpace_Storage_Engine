+/* Runs one I/O through the calling thread's async frontend and polls for its
+ * completion on this thread. The File is owned by the process-level client and
+ * the submitting client owns slots, credits and completions (design §20.4).
+ * Returns false when the async path cannot be used (nothing was submitted), so
+ * the caller falls back to the synchronous facade. */
+bool asyncIo(const std::shared_ptr<hfs::File> &file, void *buf, std::size_t n,
+             std::uint64_t offset, bool write, std::size_t *out, int *errorOut) {
+  ThreadClientHolder *holder = t_holder.get();
+  if (holder == nullptr || holder->client == nullptr || file == nullptr || n == 0) {
+    state().asyncFallbacks.fetch_add(1, std::memory_order_relaxed);
+    return false;
+  }
+  hfs::CompletionToken token{};
+  token.slot = 0;
+  token.generation = ++holder->tokenGeneration;
+  if (token.generation == 0) {
+    token.generation = ++holder->tokenGeneration;
+  }
+  hfs::IoVec vec{static_cast<std::byte *>(buf), n};
+  auto submitted = write ? holder->client->submitWrite(file, vec, offset, token)
+                         : holder->client->submitRead(file, vec, offset, token);
+  if (!submitted.ok()) {
+    /* Growth writes and exhausted frontends land here; the sync path owns them. */
+    state().asyncFallbacks.fetch_add(1, std::memory_order_relaxed);
+    return false;
+  }
+  auto io = std::move(submitted).value();
+  const std::uint64_t requestId = io.requestId();
+  std::array<hfs::CompletionEvent, 8> events{};
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(60);
+  for (;;) {
+    auto polled = holder->client->poll(
+        std::span<hfs::CompletionEvent>(events.data(), events.size()), 1, events.size(),
+        std::chrono::microseconds(1000));
+    if (polled.status != hfs::Status::Ok) {
+      *errorOut = EIO;
+      return true;
+    }
+    for (std::size_t index = 0; index < polled.count; ++index) {
+      if (events[index].requestId != requestId) {
+        continue;
+      }
+      if (events[index].status != hfs::Status::Ok) {
+        setErrno(events[index].status);
+        *errorOut = errno != 0 ? errno : EIO;
+        return true;
+      }
+      *out = static_cast<std::size_t>(events[index].completedBytes);
+      if (write) {
+        state().asyncWrites.fetch_add(1, std::memory_order_relaxed);
+      } else {
+        state().asyncReads.fetch_add(1, std::memory_order_relaxed);
+      }
+      return true;
+    }
+    if (std::chrono::steady_clock::now() >= deadline) {
+      *errorOut = ETIMEDOUT;
+      return true;
+    }
+  }
+}
